# ---------------------------------------------------------------------------
# Project Hub configuration. Copy to .env for local development.
# Every service validates its configuration at startup and refuses to start
# when a required value is missing or malformed.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Public URL of the web application (used in links, e-mails and CSRF origin checks)
APP_URL=http://localhost:3100
# Base URL of customer review links (the web app serves /r/<token>)
REVIEW_BASE_URL=http://localhost:3100/r

# API service
API_PORT=4000
# Where the web server reaches the API (server-side rewrites)
API_INTERNAL_URL=http://127.0.0.1:4000

# Preview gateway: every preview gets <slug>.<PREVIEW_BASE_DOMAIN>
# *.localhost resolves to 127.0.0.1 in browsers, so no DNS setup is needed locally.
PREVIEW_PORT=4100
PREVIEW_BASE_DOMAIN=preview.localhost
PREVIEW_PUBLIC_URL_TEMPLATE=http://{slug}.preview.localhost:4100
# Ports used by process-based previews (apps started with start.command)
PREVIEW_PORT_RANGE=41000-41999

# PostgreSQL 18+ (pnpm db:start runs a local server matching this URL)
DATABASE_URL=postgres://projecthub:projecthub-dev@127.0.0.1:54329/projecthub
TEST_DATABASE_URL=postgres://projecthub:projecthub-dev@127.0.0.1:54329/projecthub_test

# Runtime data lives beside the source checkout, never inside it. This keeps Git/Docker contexts small and makes the
# source tree disposable. PostgreSQL, scanner tools and operator scratch files use the same runtime root.
PROJECTHUB_RUNTIME_DIR=../PROJECTHUB_RUNTIME
# Repositories, artifacts, build/AI workspaces, logs, uploads and backups
STORAGE_DIR=../PROJECTHUB_RUNTIME/storage

# 32 random bytes, base64. Encrypts secrets, deploy credentials and review tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Session cookie
SESSION_TTL_HOURS=12
# Second sign-in step by e-mail: "required" sends a one-time code to every account without an authenticator app or
# passkey (needs SMTP below). "off" only for installations without e-mail.
AUTH_EMAIL_CODE=required
# Passkeys (fingerprint / Face ID / Windows Hello) are bound to this host. Empty = the host of APP_URL.
WEBAUTHN_RP_ID=
COOKIE_SECURE=false

# Builds: "process" runs commands in an isolated workspace directory on the worker host.
BUILD_CONCURRENCY=1
BUILD_TIMEOUT_MINUTES=20
# Dependency installs get their own budget: an uncached first install of a large project can exceed the build limit.
BUILD_INSTALL_TIMEOUT_MINUTES=45
# Optional for a standalone worker with Docker available. Untrusted projects remain blocked in both modes.
# container = install/build/test (and the AI's checks) run in a locked-down Linux container, on a Docker volume (one
# tar stream in and out, so Docker Desktop on Windows/macOS is fast too). Recommended everywhere. Build the image once:
#   docker build -t projecthub/build:php8.4-node22 deploy/build-image   (PHP 8.4 + Composer + Node 22)
# host = commands run as the worker's OS user: development only; refused with NODE_ENV=production unless
# ALLOW_HOST_BUILDS=true (the worker itself is an isolated container or a dedicated build machine).
BUILD_EXECUTOR=container
BUILD_CONTAINER_IMAGE=projecthub/build:php8.4-node22
BUILD_CONTAINER_CPUS=4
BUILD_CONTAINER_MEMORY_MB=6144
BUILD_CONTAINER_PIDS=1024
# Server previews in their own locked-down container (same image; non-root, read-only root, no capabilities,
# published on 127.0.0.1 only). Secrets pointing at 127.0.0.1/localhost are rewritten to host.docker.internal.
# Production refuses PREVIEW_EXECUTOR=host unless ALLOW_HOST_BUILDS=true.
PREVIEW_EXECUTOR=container
PREVIEW_CONTAINER_CPUS=2
PREVIEW_CONTAINER_MEMORY_MB=3072
PREVIEW_CONTAINER_PIDS=512
# Heavy jobs (build, preview, browser, AI) wait while free memory is below this (MB) — never started anyway; AI jobs
# also count the RAM their loaded model already holds. 0 = off.
# GIT_IMPORT_ALLOWED_HOSTS=gitlab.example.com,github.com   (optional allow-list for Git imports)
MIN_FREE_MEMORY_MB=1024
# Git import/sync from file paths, localhost or cloud-metadata addresses. Keep false (tests/single machine only).
GIT_IMPORT_ALLOW_LOCAL=false

# Deployment: extra server directories the "local" adapter may publish to (comma separated).
DEPLOY_LOCAL_ROOTS=
# pg_dump used for pre-deployment database backups of managed projects
PG_DUMP_BINARY=pg_dump

# Local AI (default). Ollama runs on infrastructure you control and needs no API key.
# Install Ollama separately for local development, then pull the configured model.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=embeddinggemma:300m-qat-q4_0
OLLAMA_REQUEST_TIMEOUT_SECONDS=300
# Context window requested per call (num_ctx); keep the system prompt and tool definitions from being truncated.
OLLAMA_CONTEXT_TOKENS=16384
# Model layers on the GPU (num_gpu); 0 = Ollama decides. 8 GB GPU + qwen3-coder:30b at 32k context: 16.
OLLAMA_GPU_LAYERS=0
# Hidden reasoning for thinking models (qwen3, deepseek-r1). Off: much faster agent steps on small GPUs.
OLLAMA_THINKING=false
# Browser terminal (each command in a locked-down container). Needs a Docker engine the worker can reach.
TERMINAL_ENABLED=false
TERMINAL_IMAGE=node:22-bookworm-slim
TERMINAL_NETWORK=bridge
# Docker CLI path when it is not on PATH (Docker Desktop on Windows).
DOCKER_BINARY=

# Optional cloud compatibility. These providers are never required for core AI functionality.
# Provider/model can be chosen in Admin > AI Control Center; keys are only read from here.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: route AI calls through a corporate gateway / proxy (leave empty for the provider's public API).
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# Dependency vulnerability database (OSV.dev). Empty disables online dependency scanning.
OSV_API_URL=https://api.osv.dev
# External scanners: <dir>/gitleaks/gitleaks[.exe] (secrets in Git history). Empty = "tools" next to STORAGE_DIR,
# then PATH (the Docker worker image has gitleaks on PATH). A missing tool is reported in the scan, never as clean.
SCANNER_TOOLS_DIR=
# Package registries for "latest version" checks in the Dependency Center (empty skips that ecosystem).
NPM_REGISTRY_URL=https://registry.npmjs.org
PYPI_URL=https://pypi.org
PACKAGIST_URL=https://repo.packagist.org

# Browser automation for screenshots and responsive tests (requires: pnpm exec playwright install chromium)
BROWSER_AUTOMATION=true

# E-mail (optional). Without SMTP, invitation/reset links are shown to the admin instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Project Hub <noreply@example.com>
